{
  "name": "@waimai/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "build": "tsup src/server.ts --format esm --platform node --target node20 --no-external @waimai/shared --out-dir dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@waimai/shared": "workspace:*",
    "@prisma/client": "6.19.0",
    "express": "^4.21.2",
    "zod": "^3.25.76",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.3",
    "multer": "^2.0.2",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.2.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/cookie-parser": "^1.4.9",
    "tsup": "^8.5.0"
  }
}
