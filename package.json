{
  "name": "waimai",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,pc,mobile \"pnpm --filter @waimai/backend dev\" \"pnpm --filter @waimai/frontend dev\" \"pnpm --filter @waimai/mobile dev\"",
    "lint": "eslint packages frontend mobile backend",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @waimai/backend start",
    "db:setup": "pnpm --filter @waimai/backend db:setup",
    "format": "prettier --write packages frontend mobile backend docs README.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  }
}
